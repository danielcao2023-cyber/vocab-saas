    {
      "id": "s3",
      "title": "泄露；泄出（信息，动词）",
      "meaning": "有意向外透露保密信息，或秘密信息未经许可传出。",
      "usageNote": "及物时可说 leak information to someone；不及物时可说 information leaks out。",
      "examples": [
        {
          "id": "s3-e1",
          "senseId": "s3",
          "en": "Someone leaked the secret plans to a reporter.",
          "zh": "有人向一名记者泄露了秘密计划。"
        },
        {
          "id": "s3-e2",
          "senseId": "s3",
          "en": "Details of the plan leaked out before the meeting.",
          "zh": "计划的细节在会议前泄露了出去。"
        }
      ],
      "patterns": [],
      "collocations": [
        {
          "en": "leak information to a reporter",
