  "senses": [
    {
      "id": "s1",
      "title": "漏出；泄漏（动词）",
      "meaning": "液体、气体从孔隙逸出，或容器让液体、气体漏出。",
      "usageNote": "可用 leak from；容器作主语时也可说 leak water。",
      "examples": [
        {
          "id": "s1-e1",
          "senseId": "s1",
          "en": "Water leaked from the pipe.",
          "zh": "水从管道漏出。"
        },
        {
          "id": "s1-e2",
          "senseId": "s1",
          "en": "The container leaked oil.",
          "zh": "容器漏出了油。"
        }
      ],
      "patterns": [],
      "collocations": [
        {
          "en": "leak from a pipe",
          "zh": "从管道漏出",
          "note": "from 引出来源。",
          "kind": "common-collocation"
        },
        {
          "en": "leak oil",
          "zh": "漏油",
          "note": "oil 是漏出的物质。",
          "kind": "common-collocation"
        }
      ],
      "relatedExpressions": {
        "similar": [],
