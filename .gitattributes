# Review CSVs retain their original CRLF bytes as part of the audit record.
app/qa/**/*.csv whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol

# Keep the official Windows Gradle launcher CRLF format.
app/android/gradlew.bat whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
